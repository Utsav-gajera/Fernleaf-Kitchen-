# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port
PORT=3001

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:3000

# JWT Secret Key (generate a secure random string for production)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345

# ----------------------------------------------------
# CLOUD DATABASE CONNECTION URL
# Supported: Neon (Recommended), Supabase, Railway, Render, etc.
# ----------------------------------------------------
# Example Neon PostgreSQL (free, instant setup at https://neon.tech):
# DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Example Supabase (at https://supabase.com):
# DATABASE_URL="postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter_db?schema=public"
