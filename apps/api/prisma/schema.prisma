generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum StaffRole {
  ADMIN
  KITCHEN
  DISPATCH
  DRIVER
}

enum DishTemperature {
  HOT
  COLD
}

// ============================================================================
// STAFF & USER MANAGEMENT
// ============================================================================

model StaffUser {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  role      StaffRole @default(ADMIN)
  isActive  Boolean   @default(true)

  // Relations
  defaultDriverCompanies Company[] @relation("CompanyDefaultDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_users")
}

// ============================================================================
// COMPANY & EMPLOYEE DOMAIN
// ============================================================================

model Company {
  id                   String   @id @default(uuid())
  name                 String
  billingContactName   String?
  billingContactEmail  String?
  billingContactPhone  String?

  // Owner reference (One of its employees is the owner)
  ownerId              String?  @unique
  owner                Employee? @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Pricing Tier
  priceTierId          String?
  priceTier            PriceTier? @relation(fields: [priceTierId], references: [id], onDelete: SetNull)

  // Delivery defaults
  defaultDeliveryTime  String   @default("12:00")
  deliveryLeadMinutes  Int      @default(60)
  defaultPackaging     String   @default("STANDARD")
  standingInstructions String?
  defaultDriverId      String?
  defaultDriver        StaffUser? @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)

  // Operating days (Company Calendar Mon-Fri default)
  mon                  Boolean  @default(true)
  tue                  Boolean  @default(true)
  wed                  Boolean  @default(true)
  thu                  Boolean  @default(true)
  fri                  Boolean  @default(true)
  sat                  Boolean  @default(false)
  sun                  Boolean  @default(false)

  isActive             Boolean  @default(true)

  // Relations
  domains              CompanyDomain[]
  addresses            CompanyAddress[]
  employees            Employee[] @relation("CompanyEmployees")
  holidays             CompanyHoliday[]
  hiddenCategories     CompanyHiddenCategory[]
  hiddenDishes         CompanyHiddenDish[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("companies")
}

model CompanyDomain {
  id        String   @id @default(uuid())
  domain    String   @unique
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("company_domains")
}

model CompanyAddress {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("company_addresses")
}

model Employee {
  id                       String   @id @default(uuid())
  companyId                String
  company                  Company  @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  email                    String   @unique
  name                     String
  canChooseDeliveryAddress Boolean  @default(false)
  canChangeDeliveryTime    Boolean  @default(false)
  canChangePackaging       Boolean  @default(false)

  // Owner back-relation
  ownedCompany             Company? @relation("CompanyOwner")

  // Preferences & Allergies
  allergies                EmployeeAllergen[]
  dietaryPreferences       EmployeeDietaryTag[]

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("employees")
}

// ============================================================================
// CATALOGUE & REFERENCE DATA
// ============================================================================

model Allergen {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  dishes      DishAllergen[]
  options     OptionAllergen[]
  employees   EmployeeAllergen[]

  createdAt   DateTime @default(now())

  @@map("allergens")
}

model DietaryTag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  dishes      DishDietaryTag[]
  options     OptionDietaryTag[]
  employees   EmployeeDietaryTag[]

  createdAt   DateTime @default(now())

  @@map("dietary_tags")
}

model KitchenStation {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  dishes      Dish[]

  createdAt   DateTime @default(now())

  @@map("kitchen_stations")
}

model Dish {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?
  image          String?
  temperature    DishTemperature @default(HOT)
  costPriceMinor Int             // Stored in integer minor units (cents)
  stationId      String?
  station        KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  minQuantity    Int?
  isActive       Boolean         @default(true) // Deactivated, never hard-deleted

  allergies          DishAllergen[]
  dietaryTags        DishDietaryTag[]
  optionGroups       DishOptionGroup[]
  categories         CategoryDish[]
  tierPrices         DishPrice[]
  hiddenByCompanies  CompanyHiddenDish[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("dishes")
}

model Option {
  id             String   @id @default(uuid())
  name           String
  description    String?
  costPriceMinor Int      // Stored in integer minor units (cents)
  isActive       Boolean  @default(true)

  allergies      OptionAllergen[]
  dietaryTags    OptionDietaryTag[]
  groups         OptionGroupOption[]
  tierPrices     OptionPrice[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("options")
}

model OptionGroup {
  id            String   @id @default(uuid())
  name          String
  isRequired    Boolean  @default(false)
  allowPortions Boolean  @default(false)

  dishes        DishOptionGroup[]
  options       OptionGroupOption[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("option_groups")
}

model DishOptionGroup {
  id                 String      @id @default(uuid())
  dishId             String
  dish               Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  optionGroupId      String
  optionGroup        OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  displayOrder       Int         @default(0)
  isRequiredOverride Boolean?

  @@unique([dishId, optionGroupId])
  @@map("dish_option_groups")
}

model OptionGroupOption {
  id               String      @id @default(uuid())
  optionGroupId    String
  optionGroup      OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  optionId         String
  option           Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  displayOrder     Int         @default(0)
  extraChargeMinor Int         @default(0) // Extra charge in integer minor units

  @@unique([optionGroupId, optionId])
  @@map("option_group_options")
}

// ============================================================================
// MENU BASICS & HIDING RULES
// ============================================================================

model Category {
  id                 String   @id @default(uuid())
  name               String
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  isSecret           Boolean  @default(false)

  dishes             CategoryDish[]
  hiddenByCompanies  CompanyHiddenCategory[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("categories")
}

model CategoryDish {
  id           String   @id @default(uuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dishId       String
  dish         Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  @@unique([categoryId, dishId])
  @@map("category_dishes")
}

model CompanyHiddenCategory {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([companyId, categoryId])
  @@map("company_hidden_categories")
}

model CompanyHiddenDish {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([companyId, dishId])
  @@map("company_hidden_dishes")
}

// ============================================================================
// PRICING BASICS & TIERS
// ============================================================================

model PriceTier {
  id                String      @id @default(uuid())
  name              String      @unique
  description       String?
  isDefault         Boolean     @default(false)

  // Derived pricing (e.g. Cost x 2.4 or Standard + 15%)
  derivedFromTierId String?
  derivedFromTier   PriceTier?  @relation("TierDerivation", fields: [derivedFromTierId], references: [id], onDelete: SetNull)
  derivedTiers      PriceTier[] @relation("TierDerivation")
  multiplier        Float?

  companies         Company[]
  dishPrices        DishPrice[]
  optionPrices      OptionPrice[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("price_tiers")
}

model DishPrice {
  id          String    @id @default(uuid())
  priceTierId String
  priceTier   PriceTier @relation(fields: [priceTierId], references: [id], onDelete: Cascade)
  dishId      String
  dish        Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  priceMinor  Int       // Price in integer minor units (cents)

  @@unique([priceTierId, dishId])
  @@map("dish_prices")
}

model OptionPrice {
  id          String    @id @default(uuid())
  priceTierId String
  priceTier   PriceTier @relation(fields: [priceTierId], references: [id], onDelete: Cascade)
  optionId    String
  option      Option    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  priceMinor  Int       // Price in integer minor units (cents)

  @@unique([priceTierId, optionId])
  @@map("option_prices")
}

// ============================================================================
// CALENDARS & SETTINGS
// ============================================================================

model PlatformSettings {
  id                         String   @id @default("default")
  kitchenTimeZone            String   @default("Asia/Kolkata")
  cutOffTime                 String   @default("16:00")
  cutOffWorkingDays          Int      @default(2)
  dispatchLeadMinutes        Int      @default(60)
  kitchenReadyBufferMinutes  Int      @default(30)
  updatedAt                  DateTime @updatedAt

  @@map("platform_settings")
}

model KitchenHoliday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())

  @@map("kitchen_holidays")
}

model CompanyHoliday {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime
  name      String
  createdAt DateTime @default(now())

  @@unique([companyId, date])
  @@map("company_holidays")
}

// ============================================================================
// MANY-TO-MANY ALLERGEN & DIETARY JOIN TABLES
// ============================================================================

model DishAllergen {
  id         String   @id @default(uuid())
  dishId     String
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([dishId, allergenId])
  @@map("dish_allergens")
}

model DishDietaryTag {
  id           String     @id @default(uuid())
  dishId       String
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dietaryTagId String
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@unique([dishId, dietaryTagId])
  @@map("dish_dietary_tags")
}

model OptionAllergen {
  id         String   @id @default(uuid())
  optionId   String
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([optionId, allergenId])
  @@map("option_allergens")
}

model OptionDietaryTag {
  id           String     @id @default(uuid())
  optionId     String
  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  dietaryTagId String
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@unique([optionId, dietaryTagId])
  @@map("option_dietary_tags")
}

model EmployeeAllergen {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([employeeId, allergenId])
  @@map("employee_allergens")
}

model EmployeeDietaryTag {
  id           String     @id @default(uuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dietaryTagId String
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dietaryTagId])
  @@map("employee_dietary_tags")
}
